# 国内接口示例：通义千问 Qwen（OpenAI 兼容）
VIDEO_AGENT_PROVIDER=openai_compatible
VIDEO_AGENT_API_KEY=
VIDEO_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_AGENT_VISION_MODEL=qwen3-vl-flash

# 豆包示例：
# VIDEO_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VIDEO_AGENT_VISION_MODEL=你的模型名或推理接入点ID

# 智谱 GLM 示例：
# VIDEO_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VIDEO_AGENT_VISION_MODEL=glm-4.5v

# Gemini 示例：
# VIDEO_AGENT_PROVIDER=gemini
# VIDEO_AGENT_API_KEY=
# VIDEO_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VIDEO_AGENT_VISION_MODEL=gemini-2.5-flash

# 听觉模型：none、local_whisper 或 openai_compatible
VIDEO_AGENT_TRANSCRIPTION_PROVIDER=none

# 免费本地 Whisper：先运行 ./script/setup_local_whisper.sh
VIDEO_AGENT_LOCAL_WHISPER_MODEL=models/ggml-large-v3-turbo.bin
VIDEO_AGENT_TRANSCRIPTION_PROMPT=教程、收藏夹、抖音、私信、下载视频、爬取视频、飞书表格、Codex。
VIDEO_AGENT_TRANSCRIPTION_LANGUAGE=zh

# 云端 OpenAI 兼容语音转写（仅 provider=openai_compatible 时需要）
VIDEO_AGENT_TRANSCRIPTION_MODEL=
VIDEO_AGENT_TRANSCRIPTION_BASE_URL=
VIDEO_AGENT_TRANSCRIPTION_API_KEY=

# 本地处理参数
VIDEO_AGENT_OUTPUT_DIR=output
VIDEO_AGENT_FRAME_INTERVAL=6
VIDEO_AGENT_MAX_FRAMES=60
VIDEO_AGENT_SCENE_THRESHOLD=0.30
VIDEO_AGENT_BATCH_SIZE=12
VIDEO_AGENT_MAX_DETAIL_REQUESTS=3
VIDEO_AGENT_FRAME_WIDTH=1280
VIDEO_AGENT_REQUEST_TIMEOUT=180
